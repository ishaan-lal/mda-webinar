# Copy to .env and fill in. Never commit .env.
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=
ANTHROPIC_API_KEY=

# The repo Patch works on (owner/name). Defaults to ishaan-lal/simple-game.
# Point it at your own fork to run the demo against that instead.
PATCH_REPO=ishaan-lal/simple-game

# GitHub token for the `patch-github` connection. Fine-grained PAT scoped to
# PATCH_REPO: Contents + Pull requests (read/write).
# - Under `mda dev`, the connection reads this variable directly.
# - For the deployment, store it in the workspace once (after the first deploy):
#     uv run mda connections create patch-github --secret-from-env MDA_DEV_PATCH_GITHUB
MDA_DEV_PATCH_GITHUB=

# Slack needs no keys here: mda deploy sets it up.
