LANGSMITH_API_KEY=
ANTHROPIC_API_KEY=

# Your fork of simple-game, as owner/name, e.g. ishaan-lal/simple-game.
PATCH_REPO=

# A fine-grained GitHub token scoped to ONLY your fork, with
# Contents + Pull requests (read/write). Under `mda dev`, the `patch-github`
# connection reads it from here. 
MDA_DEV_PATCH_GITHUB=

