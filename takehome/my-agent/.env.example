LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=
ANTHROPIC_API_KEY=

# Your fork of simple-game, as owner/name, e.g. octocat/simple-game.
PATCH_REPO=

# A fine-grained GitHub token scoped to ONLY your fork, with
# Contents + Pull requests (read/write). Under `mda dev`, the `patch-github`
# connection reads it from here. 
# Later in this exercise, you will store it in LangSmith with:
#   uv run mda connections create patch-github --secret-from-env MDA_DEV_PATCH_GITHUB
MDA_DEV_PATCH_GITHUB=

